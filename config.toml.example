# Foxing Comprehensive Configuration Example
# ------------------------------------------
# Optimized for a mixed environment:
# 1. Fast NVMe Source -> NVMe (Hot), HDD (Warm), NFS (Cold)
# 2. Slow HDD Source  -> HDD (Backup)
# 3. One-Shot Source  -> External SSD (Ad-hoc)

# --- GLOBAL SETTINGS ---
# Number of worker threads per target. 
# Increase if you have many CPU cores and slow IO.
worker_count = 8

# Global Event Queue Depth.
# For NVMe sources generating massive bursts (1M+ IOPS), keep this high
# to prevent "Sequence Gaps" / drops during storms.
queue_max = 2000000

# Global Memory Limit for buffers (MB).
global_buffer_limit = 8192

# ==============================================================================
# SOURCE 1: HIGH PERFORMANCE NVMe
# Location: /mnt/nvme_source
# Data: Active User Data, Projects, VMs
# ==============================================================================
[[source]]
path = "/mnt/nvme_source"

  # --- Target A: Local High-Availability Mirror (NVMe -> NVMe) ---
  # Goal: Real-time replication, lowest latency.
  [[source.targets]]
  path = "/mnt/nvme_mirror/hot_replica"
  
  # "NVMe" Profile: Uses small coalescing windows and frequent flushes.
  profile = "NVMe"
  
  # Autotuning: Try to keep replication lag under 15ms.
  # If lag exceeds this, backpressure is applied to the source (throttling).
  autotune_target_latency_ms = 15
  
  # Features
  initial_sync = true
  supports_reflink = true  # Use Copy-on-Write (XFS/Btrfs)
  vdo_optimization = true  # Detect and punch holes in sparse files (VM images)

  # Filtering
  # Ignore heavy temporary folders to save bandwidth
  exclude = [
    "**/node_modules/**",
    "**/.cache/**",
    "**/*.tmp"
  ]


  # --- Target B: Local Archival (NVMe -> HDD) ---
  # Goal: Versioned backup, throughput optimized, seek-friendly.
  [[source.targets]]
  path = "/mnt/hdd_array/archive"
  
  # "HDD" Profile: Aggressively batches writes to linearize IO and avoid seeking.
  profile = "HDD"
  
  # Relaxed latency target (500ms) allows the daemon to buffer more data
  # before waking up the spinning disks.
  autotune_target_latency_ms = 500
  
  # Versioning (MARS - Time Travel)
  enable_versioning = true
  max_versions = 24          # Keep last 24 changes default
  max_versions_size_mb = 1024 # Max 1GB of versions per file

  # Granular Retention Policies
  # "I want to keep MORE versions of my config files, even if they are old."
  force_retention_files = [
    "**/*.conf",
    "**/*.yaml", 
    "**/production.env"
  ]
  # Force retention count for the files matched above
  force_retention_count = 100 


  # --- Target C: Offsite Disaster Recovery (NVMe -> NFS) ---
  # Goal: Resilience, tolerant of network latency.
  [[source.targets]]
  path = "/mnt/nfs_share/offsite"
  
  # "Network" Profile: Larger buffers to fill TCP window, tolerates RTT spikes.
  profile = "Network"
  
  autotune_target_latency_ms = 1000 # 1 second allowed lag
  batch_size = 256                  # Send more events per syscall


# ==============================================================================
# SOURCE 2: COLD STORAGE (HDD)
# Location: /mnt/hdd_data
# Data: Logs, Media
# ==============================================================================
[[source]]
path = "/mnt/hdd_data"

  # --- Target D: Disk-to-Disk Backup (HDD -> HDD) ---
  [[source.targets]]
  path = "/mnt/backup_drive/cold_copy"
  
  profile = "HDD"
  
  # Only replicate specific important directories
  include = [
    "/mnt/hdd_data/important_docs/**",
    "/mnt/hdd_data/photos/**"
  ]
  # (Implicitly excludes everything else not matched by include)

  enable_versioning = false # Simple mirror, no history
  initial_sync = true

# ==============================================================================
# SOURCE 3: SIMPLE ONE-SHOT MODE
# Location: /home/user/project
# Data: Ad-hoc transfer
# Usage: foxing --config config.toml --one-shot
# ==============================================================================
[[source]]
path = "/home/user/project"

  # --- Target E: External USB SSD ---
  [[source.targets]]
  path = "/media/user/Samsung_T7/project_backup"
  
  # "SSD" Profile: Balanced tuning for generic Flash storage (SATA/USB)
  # Less aggressive than NVMe, but faster than HDD.
  profile = "SSD"
  
  initial_sync = true
  enable_versioning = false
